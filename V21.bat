@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "Add-Type -AssemblyName System.Windows.Forms,System.Drawing; $f=New-Object Windows.Forms.Form; $f.Text='Система'; $f.Size=New-Object Drawing.Size(300,150); $f.StartPosition='CenterScreen'; $f.FormBorderStyle='FixedDialog'; $f.MaximizeBox=$false; $f.MinimizeBox=$false; $f.TopMost=$true; $l=New-Object Windows.Forms.Label; $l.Text='Введите код:'; $l.Location=New-Object Drawing.Point(20,20); $l.Size=New-Object Drawing.Size(250,20); $f.Controls.Add($l); $b=New-Object Windows.Forms.TextBox; $b.Location=New-Object Drawing.Point(20,50); $b.Size=New-Object Drawing.Size(240,25); $b.PasswordChar='*'; $f.Controls.Add($b); $btn=New-Object Windows.Forms.Button; $btn.Text='OK'; $btn.Location=New-Object Drawing.Point(100,85); $btn.Size=New-Object Drawing.Size(80,25); $btn.Add_Click({if($b.Text -eq '3721'){$f.Close()}else{$b.Clear();[Windows.Forms.MessageBox]::Show('Неверный код')}}); $f.Controls.Add($btn); $f.AcceptButton=$btn; $f.Add_FormClosing({if($b.Text -ne '3721'){$_.Cancel=$true}}); [void]$f.ShowDialog()"